PORT=3010
NODE_ENV=development

# PostgreSQL (dueño: vidalstore-eventos, esquema eventos)
DB_HOST=localhost
DB_PORT=5432
DB_USER=vidalstore
DB_PASSWORD=cambia_esta_password
DB_NAME=vidalstore
DB_SCHEMA=eventos

# RabbitMQ (consumidor). AmqpUrls permite el clúster rabbit1/rabbit2.
RABBITMQ_URLS=amqp://vidalstore:cambia_esta_password@localhost:5672,amqp://vidalstore:cambia_esta_password@localhost:5673
RABBITMQ_PREFETCH=10
RABBITMQ_TRANSIENT_RETRIES=3
RABBITMQ_TRANSIENT_RETRY_MS=2000
